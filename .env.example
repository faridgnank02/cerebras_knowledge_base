GITHUB_TOKEN=ghp_yourtokenhere

# LLM API key — set the one matching config.yaml's llm.provider.
# Resolution order per provider (first non-empty wins):
#   provider: openai     -> LLM_API_KEY, OPENAI_API_KEY, CEREBRAS_API_KEY
#   provider: anthropic  -> LLM_API_KEY, ANTHROPIC_API_KEY
CEREBRAS_API_KEY=csk-yourkeyhere
# OPENAI_API_KEY=sk-yourkeyhere
# ANTHROPIC_API_KEY=sk-ant-yourkeyhere
# LLM_API_KEY=            # provider-neutral override for any of the above
